---
const { platform1, platform2, platform3, username, site } = Astro.props;
---
<a href={`https://${platform1}.com/${username}`} target="blank">{platform1}</a>
<a href={`https://${username}.${platform2}.com/`} target="blank">{platform2}</a>
<a href={`https://${platform3}.fm/${username}`} target="blank">{platform3}</a>
<a href={`https://${username}.org/`} target="blank">{site}</a>

<style>
  a {
    padding: 0.2rem 0.05rem;
    font-weight: bold;
    font-size: clamp(0.7rem, 3vw, 0.7rem);
    background color: rgba(8, 179, 56, 0.743);
    color: white;
    text-decoration: none;
  }
</style>

