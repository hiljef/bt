---
type Props =
  | { platform1: 'instagram' | 'youtube'; username: string; platform2?: never; platform3?: never; site?: never }
  | { platform2: 'bandcamp'; username: string; platform1?: never; platform3?: never; site?: never }
  | { platform3: 'subvert'; username: string; platform1?: never; platform2?: never; site?: never }
  | { site: 'rayanza'; username: string; platform1?: never; platform2?: never; platform3?: never };

const { platform1, platform2, platform3, username, site } = Astro.props;
const platform = platform1 ?? platform2 ?? platform3 ?? site;
const href = platform1
  ? `https://${platform1}.com/${username}`
  : platform2
    ? `https://${username}.${platform2}.com/`
    : platform3
      ? `https://${platform3}.fm/${username}`
      : `https://${username}.org/`;
---
<a href={href} target="_blank" rel="noopener noreferrer" aria-label={platform} title={platform}>
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    {platform1 === 'instagram' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2.2" />
        <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="2.2" />
        <circle cx="17.7" cy="6.5" r="1.2" />
      </>
    )}
    {platform1 === 'youtube' && (
      <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.7V8.3l6.3 3.7-6.3 3.7Z" />
    )}
    {platform2 === 'bandcamp' && <path d="M9 4 2 20h14l7-16H9Z" />}
    {platform3 === 'subvert' && (
      <path d="M4 9v6m4-10v14m4-17v20m4-15v10m4-7v4" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
    )}
    {site === 'rayanza' && (
      <>
        <circle cx="12" cy="12" r="10" />
        <circle cx="12" cy="12" r="6.6" fill="none" stroke="#08b338" stroke-width="1.3" />
        <circle cx="12" cy="12" r="2.2" fill="#08b338" />
      </>
    )}
  </svg>
</a>

<style>
  a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.25rem;
    border-radius: 0.2rem;
    background-color: rgba(8, 179, 56, 0.743);
    color: white;
    text-decoration: none;
  }

  a:hover {
    background-color: rgb(9, 172, 236);
    color: white;
  }

  svg {
    display: block;
    width: 1.25rem;
    height: 1.25rem;
    fill: currentColor;
  }
</style>
