---
import Hamburger from './Hamburger.astro';
import Navigation from './Navigation.astro';
---
<header>
  <nav>
    <Hamburger />
    <Navigation />
  </nav>
<hr><br>
<div class="ascii">
  <a href="https://ascii.rest/banner/">
    <picture>
      <source media="(prefers-color-scheme: dark)" srcset="https://ascii.rest/banner/Berlintune%20Studio.dark.svg?color=3fb950,22d3ee,ab7df8&font=mixed&shadow=none&size=s">
      <img class="img-responsive"alt="Berlintune Studio" src="https://ascii.rest/banner/Berlintune%20Studio.svg?color=3fb950,22d3ee,ab7df8&font=mixed&shadow=none&size=s">
    </picture>
  </a>
</div>
  <hr>
</header>
