---
import Header from '../components/Header.astro';

import Footer from '../components/Footer.astro';

import '../styles/global.css';
import { getImage } from 'astro:assets';
import socialImageAsset from '../assets/fake_lake_2.jpg';

interface Props {
  pageTitle: string;
  description?: string;
  seoTitle?: string;
}

const { pageTitle, seoTitle, description = 'Berlin-based music studio producing and publishing music, and offering teaching and creative collaborations.' } = Astro.props;
const title = seoTitle ? `${seoTitle} | berlintune studio` : pageTitle ? `${pageTitle} | berlintune studio` : 'berlintune studio | Music, publishing and teaching in Berlin';
const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(pathname, Astro.site);
const socialImage = await getImage({ src: socialImageAsset, width: 1200, format: 'jpeg' });
const socialImageUrl = new URL(socialImage.src, Astro.site);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/favicon.png"/>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="berlintune studio" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={socialImageUrl} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:alt" content="Fake Lake by Organza Ray cover artwork" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageUrl} />
		<meta name="twitter:image:alt" content="Fake Lake by Organza Ray cover artwork" />
		<slot name="head" />
	</head>
	<body>
		<div class="div1">

		<Header />

		{pageTitle && <h1>{pageTitle}</h1>}

                <slot />

 		<Footer />
    		</div>
    		  <script>
                     import "../scripts/menu.js";
             </script>
	</body>
</html>
