---
import BaseLayout from './BaseLayout.astro';
const { frontmatter } = Astro.props;
---
<BaseLayout pageTitle={frontmatter.title}>
<meta charset="utf-8" />
<hr>
<p><em>{frontmatter.pubDate.toString().slice(0,10)}</em></p>
<p>{frontmatter.description} from {frontmatter.author}</p>
<hr>
<slot />
</BaseLayout>
