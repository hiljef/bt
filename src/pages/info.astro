---
import BaseLayout from '../layouts/BaseLayout.astro';
const pageTitle = "info";

const identity = {
  hj: "hilary jeffery",
  ep: "eleni poulou",
  city: "berlin",
  act1: "music",
  crea: ["songs", "improvisations", "texts", "collages", "radio shows"],
};

const form = ["records", "tapes", "cds", "zines", "books", "digital", "websites"];

const collab = true;
const contact = true;
const teach = true;
const free = false;
const number = 3;

const formColor = "red";
const fontWeight = "bold";
const textCase = "uppercase";
---
<BaseLayout pageTitle={pageTitle}>

		<div class="div2">
                <p><b>organza ray</b> | <b>rayanza records</b></p>
		                <ul>
 		                    <li><a href="https://hiljef.com" target="blank">{identity.hj}</a> + <a href="https://instagram.com/eleni.poulou" target="blank">{identity.ep}</a> </li>
 		                    <li>based in {identity.city} | composing + recording {identity.act1}</li>
  		                       {identity.crea.length >= 5 &&
    		                <li>{identity.crea[0]}, {identity.crea[1]}, {identity.crea[2]}, {identity.crea[3]}, {identity.crea[4]}</li>
                             }
		                </ul>
				 </div>
				 <br>
		 <div class="div3">
				<p>producing + publishing</p>
					<ul>
 		 				{form.map((form) => <li class="form">{form}</li>)}
					</ul>
		</div>
		<br>
			<div class="div4">
				{collab && <p>we are open for creative collaborations</p>}
				{teach && <p>we welcome new students</p>}
				{contact && <p>contact us via email</p>}
				{free && <p>we will work for free</p>}
		<!-- {number === 3 ? <p>the studio is big enough for 3 people</p> : <p>the studio has no space</p>} -->
		 </div>
</BaseLayout>
