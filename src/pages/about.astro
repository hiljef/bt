---
import BaseLayout from '../layouts/BaseLayout.astro';
const pageTitle = "about";

const identity = {
  hj: "hilary jeffery",
  ep: "eleni poulou",
  city: "berlin",
  act1: "music",
  prod: ["songs", "improvisations", "texts", "collages", "radio plays"],
};

const form = ["records", "tapes", "cds", "zines", "books", "digital", "websites"];

const collab = true;
const contact = true;
const teach = true;
const free = false;
const number = 3;

const formColor = "red";
const fontWeight = "bold";
const textCase = "uppercase";
---
<BaseLayout pageTitle={pageTitle}>

	<!-- <style is:global define:vars={{formColor, fontWeight, textCase}}>
 		 h1 {
    		color: blue;
    		font-size: 2rem;
 		 }
		.form {
	        color: var(--formColor);
    		font-weight: var(--fontWeight);
    		text-transform: var(--textCase);
 	        }
		</style>-->

                <p><b>private studio + music school in berlin</b></p>
                <p>who we are</p>
		                <ul>
 		                    <li>{identity.hj} + {identity.ep}</li>
 		                    <li>we live and work in {identity.city} where we compose and record {identity.act1}</li>
  		                       {identity.prod.length >= 5 &&
    		                <li>our productions include: {identity.prod[0]}, {identity.prod[1]}, {identity.prod[2]}, {identity.prod[3]} and {identity.prod[4]}</li>
                             }
		                </ul>

		<p>we publish in the following formats</p>
		<ul>
 		 {form.map((form) => <li class="form">{form}</li>)}
		</ul>

		{collab && <p>we are open for creative collaborations</p>}
		{teach && <p>we welcome new students</p>}
		{contact && <p>contact: studio [at] berlintune [dot] com</p>}
		{free && <p>we will work for free</p>}
		<!-- {number === 3 ? <p>the studio is big enough for 3 people</p> : <p>the studio has no space</p>} -->
</BaseLayout>
