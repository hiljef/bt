---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import fl1 from '../assets/fake_lake_1.jpg';
import fl2 from '../assets/fake_lake_2.jpg';
import fzs from '../assets/fzs.jpg';

const pageTitle = 'music';

const releases = [
  {
    artist: 'Organza Ray',
    title: 'Fake Lake',
    href: 'https://organzaray.bandcamp.com/album/fake-lake-ep',
    artwork: fl1,
    alt: 'Fake Lake',
  },
  {
    artist: 'Organza Ray\nAndi Toma',
    title: 'Fake Lake\n(I\'m On My Way)',
    href: 'https://organzaray.bandcamp.com/track/fake-lake-im-on-my-way',
    artwork: fl2,
    alt: 'Fake Lake 2',
  },
  {
    artist: 'Organza Ray\nOscar Wyers',
    title: 'Frulian Zwiefach Switch',
    href: 'https://organzaray.bandcamp.com/album/frulian-zweifach-switch',
    artwork: fzs,
    alt: 'Frulian Zwiefach Switch',
  },

];
---

<BaseLayout pageTitle={pageTitle}>
  <section class="discography" aria-label="Discography">
    {releases.map((release) => (
      <article class="release">
        <a
          class="release-artwork"
          href={release.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Listen to ${release.title} by ${release.artist} on Bandcamp`}
        >
          <Image
            src={release.artwork}
            alt={release.alt}
            width={600}
            height={600}
            layout="constrained"
          />
          <span class="listen-label">Listen on Bandcamp ↗</span>
        </a>
        <div class="release-details">
          <h2>{release.title}</h2>
          <p>{release.artist}</p>
        </div>
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  .discography {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.75rem, 2vw, 1.25rem);
  }

  .release {
    min-width: 0;
    overflow: hidden;
    border: 1px solid rgba(134, 235, 218, 0.65);
    border-radius: 5px;
    background: rgba(8, 179, 56, 0.04);
  }

  .release-artwork {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 1;
    background: rgba(255, 255, 255, 0.08);
  }

  .release-artwork :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 180ms ease;
  }

  .release-artwork:hover :global(img),
  .release-artwork:focus-visible :global(img) {
    transform: scale(1.035);
  }

  .listen-label {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    padding: 0.25rem 0.5rem;
    border-radius: 3px;
    background: rgba(0, 0, 0, 0.78);
    color: white;
    font-size: 0.75rem;
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .release-artwork:hover .listen-label,
  .release-artwork:focus-visible .listen-label {
    opacity: 1;
  }

  .release-artwork:focus-visible {
    outline: 2px solid rgb(9, 172, 236);
    outline-offset: -2px;
  }

  .release-details {
    padding: 0.5rem;
  }

  .release-details h2,
  .release-details p {
    margin: 0;
  }

  .release-details h2 {
    white-space: pre-line;
    font-size: 0.8rem;
  }

  .release-details p {
    white-space: pre-line;
    margin-top: 0.2rem;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.75rem;
  }

  @media (max-width: 760px) {
    .discography {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 480px) {
    .discography {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .release-artwork :global(img),
    .listen-label {
      transition: none;
    }
  }
</style>
