---
import BaseLayout from '../layouts/BaseLayout.astro';
const pageTitle ="";
const artist = {
  hj: "hilary jeffery",
  ep: "eleni poulou",
  or: "organza ray",
  };

const form = ["records", "tapes", "cds", "zines", "books", "digital", "websites"];

const school = ["trombone", "trumpet", "euphonium", "poetry", "songwriting", "composition", "improvisation", "music theory", "arrangement"];

---
<BaseLayout pageTitle={pageTitle}>
	 <div class="div2">
		 <p><b>home of</b></p>
		    <ul>
 		         <li>{artist.hj}</li>
 		         <li>{artist.ep}</li>
 		         <li>{artist.or}</li>
 		    </ul>
	 </div>
	 <br>
     <div class="div3">
 		 <p><b>producing + publishing</b></p>
		    <ul>
 		         {form.map((form) => <li>{form}</li>)}
		     </ul>
	 </div>  
	 <br>
	 <div class="div4">         
		 <p><b>teaching</b></p>
		     <ul>
 		         {school.map((school) => <li>{school}</li>)}
		    </ul>
		</div>  
</BaseLayout>