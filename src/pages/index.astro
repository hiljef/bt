---
import BaseLayout from '../layouts/BaseLayout.astro';

import { Image } from 'astro:assets';
import fl2 from '../assets/fake_lake_2.jpg';
import k19 from '../assets/K19_2.jpg';

const pageTitle ="";

const form = ["records", "tapes", "cds", "zines", "books", "digital", "websites"];

const school = ["trombone", "trumpet", "euphonium", "poetry", "songwriting", "composition", "improvisation", "music theory", "arrangement"];

---
<BaseLayout pageTitle={pageTitle}>
	 <div class="div2">
		 <p><b>berlintune studio</b></p>
	 </div>
	 <br>
	 <div class="div3">
		 <p>
		 <b>latest release</b>
		 <br><br>
		 <b>Organza Ray</b>
		 <br><br>
		 "Fake Lake"
		 </p>
		 <a href="https://organzaray.bandcamp.com/album/fake-lake-ep" target="blank">
		 <Image src={fl2} alt="fake_lake" layout='constrained' width={200} height={200} /> 
		 </a>	 
	 </div>
	     <br>
	<div class="div6">
		 <p>
		 <b>next concert</b>
		 <br><br>
		 <b>Organza Ray</b> + friends
		 <br><br>
		 Saturday 31 October @ 17:00
		 <br><br>
		 Hilary Jeffery – trombone, trumpet<br>
         Eleni Poulou – synthesizer, voice<br>
		 +<br>
         Werner Durand – birbynė, invented wind instruments, saxophone<br>
         Alfredo Genovesi – electric guitar<br>
         Juan Felipe Waller – electronics, invented instruments
		 </p>
         <Image src={k19} alt="fake_lake" layout='constrained' width={197} height={161} />
         <br><br>
         <a href="https://k19studiosberlin.de/veranstaltungen" target="blank">k19studiosberlin.de/veranstaltungen</a>
		 <br> 
	 </div>    
