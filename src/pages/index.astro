---
import BaseLayout from '../layouts/BaseLayout.astro';
const pageTitle ="";

const artist = {
  hj: "hilary jeffery",
  ep: "eleni poulou",
  or: "organza ray",
  };

const form = ["records", "tapes", "cds", "zines", "books", "digital", "websites"];

const school = ["trombone", "trumpet", "euphonium", "poetry", "songwriting", "composition", "improvisation", "music theory", "arrangement"];

const web = ["html", "css", "markdown", "javascript", "react"];
---
<BaseLayout pageTitle={pageTitle}>
          <p><b>private studio + music school</b></p>
                <p><b>home of</b></p>
		            <ul>
 		                <li>{artist.hj}</li>
 		                 <li>{artist.ep}</li>
 		                 <li>{artist.or}</li>
 		            </ul>

 		        <p><b>producing + publishing</b></p>
		                <ul>
 		                 {form.map((form) => <li>{form}</li>)}
		                </ul>
		                
		        <p><b>teaching</b></p>
		                <ul>
 		                 {school.map((school) => <li>{school}</li>)}
		                </ul>
			<!-- 
		        <p><b>website being built with Astro using</b></p>
		                <ul>
 		                {web.map((web) => <li>{web}</li>)}
		                </ul>
			-->
</BaseLayout>